# Base de datos (Supabase → Project Settings → Database → Connection string)
DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true&connection_limit=1"   # "Transaction pooler"
DIRECT_URL="postgresql://...:5432/postgres"                                       # "Session pooler" / directa
# Clave para firmar las sesiones (cualquier texto largo y secreto)
SESSION_SECRET=""
# Contraseña provisoria de la administradora la primera vez
ADMIN_CLAVE_INICIAL=""
# Fotos y copias (Supabase → Project Settings → API)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY=""
# Dirección publicada (para Mercado Pago y copias)
APP_URL="https://tu-app.netlify.app"
# Clave para la copia automática diaria (la misma va en GitHub → Settings → Secrets)
COPIA_TOKEN=""
# Correo Argentino (API MiCorreo) — cotización automática de envíos
CORREO_AR_USUARIO=""
CORREO_AR_CLAVE=""
CORREO_AR_CUSTOMER_ID=""
# Correo Argentino Paq.ar 2.0 — generar envío, rótulo oficial y seguimiento
# (requiere acuerdo comercial: se gestiona con el área Comercial de Correo Argentino)
PAQAR_API_KEY=""
PAQAR_AGREEMENT=""
PAQAR_SERVICE_TYPE="CP"
# Andreani (API con contrato propio) — cotización automática de envíos
ANDREANI_USUARIO=""
ANDREANI_CLAVE=""
ANDREANI_CLIENTE=""
ANDREANI_CONTRATO_DOMICILIO=""
ANDREANI_CONTRATO_SUCURSAL=""
# Mercado Pago (Tus integraciones → Credenciales de producción → Access Token)
MP_ACCESS_TOKEN=""
