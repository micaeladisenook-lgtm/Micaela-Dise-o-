generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  VENDEDOR
  TALLER
}

enum TipoProducto {
  SUELTO
  BOX
  KIT
  ADICIONAL
}

enum EstadoPedido {
  NUEVO
  EN_PRODUCCION
  LISTO
  ENTREGADO
  CANCELADO
}

enum TipoPedido {
  INDIVIDUAL
  BOX
  EVENTO
}

enum MedioPago {
  TRANSFERENCIA
  EFECTIVO
  TARJETA
  MERCADO_PAGO
  OTRO
}

enum OrigenPedido {
  SISTEMA
  FORMULARIO
  IMPORTADO
}

enum FuncionTaller {
  CONFECCION_ROPA
  BORDADO
  CONFECCION_PANTU
  PEGADO_PANTU
  OTRO
}

enum TipoStock {
  PRODUCTO
  INSUMO
}

enum CategoriaDiseno {
  PRODUCTO
  COLOR
  BORDADO
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  login        String   @unique
  passwordHash String
  rol          Rol      @default(VENDEDOR)
  activo       Boolean  @default(true)
  ultimoAcceso DateTime?
  debeCambiarClave Boolean @default(false)
  creadoEn     DateTime @default(now())

  clientesCreados Cliente[]  @relation("ClienteCreadoPor")
  registros       Registro[]
  pedidosVendidos Pedido[]   @relation("PedidoVendedor")
  pedidosCreados  Pedido[]   @relation("PedidoCreadoPor")
  pedidosModif    Pedido[]   @relation("PedidoModificadoPor")
  pagosCargados   Pago[]
  tallerId        String?
  taller          Taller?    @relation(fields: [tallerId], references: [id], onDelete: SetNull)
}

model Cliente {
  id          String   @id @default(cuid())
  numero      Int      @unique @default(autoincrement())
  nombre      String
  telefono    String?
  instagram   String?
  email       String?
  direccion   String?
  notas       String?
  esEjemplo   Boolean  @default(false)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  creadoPorId String?
  creadoPor   Usuario? @relation("ClienteCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  localidad   String?
  provincia   String?
  codigoPostal String?
  dni         String?
  entreCalles String?
  pedidos     Pedido[]
}

model Producto {
  id          String       @id @default(cuid())
  nombre      String
  tipo        TipoProducto
  descripcion String?
  precio      Int?
  precioAnterior Int?
  enListaPrecios Boolean   @default(true)
  pesoGramos  Int?        // peso del paquete listo para enviar
  altoCm      Float?
  anchoCm     Float?
  largoCm     Float?
  colores     String[]
  talles      String[]
  activo      Boolean      @default(true)
  orden       Int          @default(0)
  creadoEn    DateTime     @default(now())
  actualizadoEn DateTime   @updatedAt

  componentes  ComponenteBox[] @relation("Box")
  itemsPedido  PedidoItem[]
  stock        ItemStock[]
  consumos     ConsumoProducto[]
  prendasPedido PrendaItem[]
  enBoxes      ComponenteBox[] @relation("Componente")
  disenos      Diseno[]
}

// Qué prendas trae cada box o kit (para pedir color y talle de cada una)
model ComponenteBox {
  id            String   @id @default(cuid())
  boxId         String
  box           Producto @relation("Box", fields: [boxId], references: [id], onDelete: Cascade)
  componenteId  String
  componente    Producto @relation("Componente", fields: [componenteId], references: [id], onDelete: Cascade)
  cantidad      Int      @default(1)
  opcional      Boolean  @default(false)
  aEleccion     Boolean  @default(false)
  nota          String?
}

model Diseno {
  id          String          @id @default(cuid())
  nombre      String
  categoria   CategoriaDiseno
  imagen      String
  descripcion String?
  productoId  String?
  producto    Producto?       @relation(fields: [productoId], references: [id], onDelete: SetNull)
  creadoEn    DateTime        @default(now())
  pedidos     DisenoPedido[]
}

// Registro de cambios: quién hizo qué y cuándo
model Registro {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion    String
  entidad   String
  entidadId String?
  detalle   String?
  fecha     DateTime @default(now())
}

model Pedido {
  id             String       @id @default(cuid())
  numero         Int          @unique @default(autoincrement())
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipo           TipoPedido   @default(INDIVIDUAL)
  estado         EstadoPedido @default(NUEVO)
  fechaPedido    DateTime     @default(now())
  fechaEntrega   DateTime?
  fechaEvento    DateTime?
  evento         String?      // "XV", "Boda", "Cumpleaños", u otro texto
  eventoDetalle  String?      // ej: "XV de Mía", "evento en enero"
  envio          Boolean      @default(true) // true = envío, false = retira
  formaEnvio     String?      // Correo Argentino, Motomensajería, Retira…
  direccionEnvio String?
  localidad      String?
  provincia      String?
  codigoPostal   String?
  entreCalles    String?
  costoEnvio     Int?
  numeroSeguimiento String?
  despachadoEn   DateTime?
  tokenPublico   String?      @unique // para el link del resumen que se le manda a la clienta
  prioridad      Boolean      @default(false)
  total          Int          @default(0)
  notas          String?
  origen         OrigenPedido @default(SISTEMA)
  revisar        String?      // avisos de importación para revisar
  linkPago       String?      // último link de Mercado Pago generado
  linkPagoMonto  Int?
  linkPagoFecha  DateTime?
  vendedorId     String?
  vendedor       Usuario?     @relation("PedidoVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  creadoPorId    String?
  creadoPor      Usuario?     @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  modificadoPorId String?
  modificadoPor  Usuario?     @relation("PedidoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: SetNull)
  creadoEn       DateTime     @default(now())
  actualizadoEn  DateTime     @updatedAt

  items          PedidoItem[]
  pagos          Pago[]
  disenos        DisenoPedido[]
  tareas         Tarea[]
  movimientos    MovimientoStock[]

  @@index([estado])
  @@index([fechaEntrega])
  @@index([fechaEvento])
}

// Cada producto vendido dentro del pedido (un box, una bata, un adicional…)
model PedidoItem {
  id               String     @id @default(cuid())
  pedidoId         String
  pedido           Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId       String?
  producto         Producto?  @relation(fields: [productoId], references: [id], onDelete: SetNull)
  nombre           String     // nombre al momento de la venta
  persona          String?    // para quién es (ej: "Abuela", "Mamá")
  cantidad         Int        @default(1)
  precioUnitario   Int        @default(0)
  bordadoTexto     String?
  bordadoUbicacion String?
  bordadoDetalle   String?    // dónde va exactamente el bordado (texto libre para el taller)
  bordadoFotos     String[]   @default([]) // fotos de referencia de la ubicación
  hilo             String?
  notas            String?
  orden            Int        @default(0)
  prendas          PrendaItem[]
}

// Cada prenda con su color y talle (bata, pantufla, pijama…)
model PrendaItem {
  id         String     @id @default(cuid())
  itemId     String
  item       PedidoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productoId String?
  producto   Producto?  @relation(fields: [productoId], references: [id], onDelete: SetNull)
  nombre     String
  color      String?
  talle      String?
  bordada    Boolean    @default(true)
  orden      Int        @default(0)
}

model DisenoPedido {
  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  disenoId String
  diseno   Diseno @relation(fields: [disenoId], references: [id], onDelete: Cascade)
  @@id([pedidoId, disenoId])
}

model Pago {
  id          String    @id @default(cuid())
  pedidoId    String
  pedido      Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  monto       Int
  medio       MedioPago @default(TRANSFERENCIA)
  fecha       DateTime  @default(now())
  esSena      Boolean   @default(false)
  nota        String?
  creadoPorId String?
  creadoPor   Usuario?  @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoEn    DateTime  @default(now())
}

model Taller {
  id           String        @id @default(cuid())
  nombre       String
  especialidad String?
  funcion      FuncionTaller @default(OTRO)
  telefono     String?
  activo       Boolean       @default(true)
  orden        Int           @default(0)
  tareas       Tarea[]
  gastos       Gasto[]
  usuarios     Usuario[]
}

// Columnas del tablero de cada taller
enum EtapaTarea {
  PENDIENTE_ENVIO
  RECIBIDO
  EN_PRODUCCION
  LISTO
}

// Trabajo de un taller sobre una prenda de un pedido (se arma solo)
model Tarea {
  id            String     @id @default(cuid())
  pedidoId      String
  pedido        Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tallerId      String
  taller        Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  clave         String     // identifica prenda + paso, para conservar lo terminado al editar
  paso          Int        // orden dentro de la prenda (1, 2, 3)
  prenda        String
  color         String?
  talle         String?
  bordado       String?
  detalle       String?
  etapa         EtapaTarea @default(PENDIENTE_ENVIO) // columna del tablero del taller
  terminada     Boolean    @default(false)    // = etapa LISTO (se mantienen sincronizados)
  terminadaEn   DateTime?
  terminadaPorId String?
  creadoEn      DateTime   @default(now())

  @@unique([pedidoId, clave])
  @@index([tallerId, terminada])
}

model ItemStock {
  id          String    @id @default(cuid())
  tipo        TipoStock @default(INSUMO)
  categoria   String    // Telas, Hilos, Cajas, Tarjetas, Packaging, Producto terminado…
  nombre      String
  color       String?
  talle       String?
  tela        String?   // Satén / Plush (para telas)
  unidad      String    @default("unidades")
  cantidad    Float     @default(0)
  minimo      Float     @default(0)
  productoId  String?
  producto    Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  activo      Boolean   @default(true)
  creadoEn    DateTime  @default(now())
  movimientos MovimientoStock[]
  consumos    ConsumoProducto[]
}

model MovimientoStock {
  id        String    @id @default(cuid())
  itemId    String
  item      ItemStock @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cantidad  Float     // positivo = entra, negativo = sale
  motivo    String
  pedidoId  String?
  pedido    Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  usuarioId String?
  fecha     DateTime  @default(now())
}

// Qué insumos usa cada producto (se descuentan solos al vender)
model ConsumoProducto {
  id          String     @id @default(cuid())
  productoId  String
  producto    Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  itemId      String?    // insumo fijo (ej: Caja)
  item        ItemStock? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tela        String?    // o tela según el color de la prenda (ej: "Satén")
  cantidad    Float
}

model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  categoria   String
  descripcion String?
  monto       Int
  medio       String?
  tallerId    String?
  taller      Taller?  @relation(fields: [tallerId], references: [id], onDelete: SetNull)
  creadoPorId String?
  creadoEn    DateTime @default(now())

  @@index([fecha])
}

// Plantillas de mensajes de WhatsApp (editables)
model Plantilla {
  clave   String @id
  titulo  String
  texto   String
}

// Permisos configurables por rol (la administradora siempre tiene todos)
model Permiso {
  rol       Rol
  clave     String
  permitido Boolean @default(false)
  @@id([rol, clave])
}

// Ajustes generales del sistema (ej: código postal de origen de los envíos)
model Configuracion {
  clave String @id
  valor String
}

// Motomensajería: precio por localidad / barrio (editable desde Envíos)
model TarifaMoto {
  id        String @id @default(cuid())
  zona      String
  localidad String
  precio    Int

  @@unique([zona, localidad])
}
